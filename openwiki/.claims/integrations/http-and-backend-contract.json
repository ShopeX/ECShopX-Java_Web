    },
    {
      "id": "claim_58c8519712ab4b2abddd3b234716ba92",
      "statement": "For successful API responses, the plugin interprets a business envelope through `response._data.data`, rejects business `status_code` values at or above 400 as non-retryable `BUSINESS_ERROR`, and unwraps the successful data payload before returning it to clients.",
      "evidence": [
        {
          "resource": "repo://app/plugins/http.ts#L108-L124",
          "version": "repo-lines-v1:sha256:371939389d2b1aaccd222a4c9ca3d33697fb5b1fba783aabe62510f8ca11e74f:"
        },
        {
          "resource": "repo://app/plugins/http.ts#L334-L373",
          "version": "repo-lines-v1:sha256:c5060ba1fd70947a1a0ff5d6561e4db27dd02d23a1fe26f14b35d0da9fe5a795:"
        },
        {
