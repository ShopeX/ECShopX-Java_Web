        }
      ]
    },
    {
      "id": "claim_72534ce79cc14cee90ee3db51e9f8d06",
      "statement": "The plugin captures `X-Token` and `X-Refresh-Token` response headers into the `token` and `refresh-token` cookies, independently of body transformation.",
      "evidence": [
        {
          "resource": "repo://app/plugins/http.ts#L316-L329",
          "version": "repo-lines-v1:sha256:5bddd83ab30f5943b16e839c0c4b85cd9e2da3a287f217ef8f3215a5edc26178:"
        }
      ]
    },
    {
      "id": "claim_ef3fbd45d9944c68940fd54a7e9617a3",
      "statement": "HTTP response failures are normalized into `HttpError` categories: 401 authentication, 403 permission, 422 validation, 5xx server, other HTTP errors, plus timeout, network, and unknown error categories; retry eligibility is limited to 408, 429, 500, 502, 503, and 504, and errors are rethrown after optional client-side toast handling.",
      "evidence": [
        {
          "resource": "repo://app/plugins/http.ts#L127-L153",
          "version": "repo-lines-v1:sha256:1c048232049d2da2547d8c392dc6fb9baf47fa8077517671dda5fbfa1fcfb9f6:"
        },
        {
