          "version": "repo-lines-v1:sha256:0a8bc724649bea089f6c251ac9675be8283bd887863b150256a78ad82295117d:"
        }
      ]
    },
    {
      "id": "claim_4428f023396d4aa6ac8549d9dd5eb242",
      "statement": "The shared `$fetch` instance is configured for three automatic retries with a one-second delay for statuses 408, 429, 500, 502, 503, and 504; this transport policy does not retry business errors.",
      "evidence": [
        {
          "resource": "repo://app/plugins/http.ts#L118-L124",
